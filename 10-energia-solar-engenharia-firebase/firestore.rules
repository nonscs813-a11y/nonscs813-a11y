rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /projetos_energia_solar/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['cliente', 'contato', 'servico', 'valor', 'status']);
      allow delete: if request.auth != null;
    }
  }
}
